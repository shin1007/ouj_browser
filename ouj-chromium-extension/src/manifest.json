{
  "manifest_version": 3,
  "name": "放送大学授業ブラウザ",
  "version": "2025.8.6",
  "description": "放送大学の放送授業での学習を便利にする拡張機能",
  "author": "shin1007",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://v.ouj.ac.jp/*",
    "https://sso.ouj.ac.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ouj.ac.jp/*"
      ],
      "css": [
        "favorite-panel.css",
        "thumbnail-progress.css"
      ],
      "js": [
        "utils/helpers.js",
        "utils/video-ending-detection.js",
        "utils/video-player-core.js",
        "utils/video-prev-next.js",
        "utils/video-radio-detection.js",
        "utils/video-settings.js",
        "utils/viewingStatus.js",
        "categories.js",
        "menu.js",
        "page-course-select.js",
        "page-login.js",
        "page-video-select.js",
        "thumbnail-progress.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}