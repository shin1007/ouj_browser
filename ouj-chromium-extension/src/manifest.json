{
  "manifest_version": 3,
  "name": "OUJ Chromium Extension",
  "version": "1.0.0",
  "description": "A Chrome extension to enhance the usability of OUJ broadcasting classes.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "autofill"
  ],
  "host_permissions": ["https://v.ouj.ac.jp/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ouj.ac.jp/*"],
      "css": ["favorite-panel.css", "thumbnail-progress.css"],
      "js": ["utils/helpers.js",
      "utils/viewingStatus.js",
      "categories.js",
      "login.js",
      "menu.js",
      "course-select.js",
      "video-select.js",
      "video.js",
      "thumbnail-progress.js",
      "content.js"
    ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}