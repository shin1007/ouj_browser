# tests/visual/ が使用する環境変数のテンプレート。
# 実際の値を入れた .env をこのファイルと同じ場所に作成してください（.env はgit管理対象外）。

# 放送大学インターネット配信サイトのログイン情報（テスト用アカウント）
OUJ_TEST_USERNAME=
OUJ_TEST_PASSWORD=

# 科目一覧ページ（series-select）のカテゴリID。
# https://v.ouj.ac.jp/view/ouj/#/navi/vod?ca=XXXX の "ca=" の値
OUJ_TEST_SERIES_CATEGORY_ID=

# 前後の動画リンクが両方表示されるコース（動画が3本以上あるもの）のカテゴリID
OUJ_TEST_MULTI_VIDEO_CATEGORY_ID=

# 通常(TV)動画のコンテンツID。
# 実際に動画を再生した状態のURL（例: .../navi/player?co=XXXX&ct=V&ca=YYYY）の
# "co=" と "ca=" の値をそのままコピーしてください。
OUJ_TEST_TV_CONTENT_ID=
OUJ_TEST_TV_CONTENT_CATEGORY_ID=

# ラジオ番組のコンテンツID（任意。指定するとラジオ用UIのスクリーンショットも撮影されます）
OUJ_TEST_RADIO_CONTENT_ID=
OUJ_TEST_RADIO_CONTENT_CATEGORY_ID=
